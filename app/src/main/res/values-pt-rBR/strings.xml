    <string name="section_accessibility">Alternativa por acessibilidade</string>
    <string name="status_enabled">Ativado</string>
    <string name="status_off">Desativado</string>
    <string name="action_manage">Gerenciar</string>
    <string name="action_enable">Ativar</string>
    <string name="accessibility_body">Opcional. Alguns apps escondem o conteúdo das capturas de tela. Ative o serviço de acessibilidade do Screen QR para o app tirar uma única captura, sem o diálogo de captura do sistema. Ele não lê mais nada e a captura nunca sai do aparelho.</string>
    <string name="accessibility_secure_note">Telas marcadas com FLAG_SECURE (apps de banco, streaming, algumas carteiras) retornam um quadro preto para qualquer método, inclusive acessibilidade.</string>

    <string name="section_reading_method">Método de leitura</string>
    <string name="engine_auto">Automático</string>
    <string name="engine_auto_subtitle">Acessibilidade quando ativa, senão o diálogo de captura do sistema</string>
    <string name="engine_accessibility">Somente acessibilidade</string>
    <string name="engine_accessibility_subtitle">Sem diálogo, mas precisa do serviço ativado</string>
    <string name="engine_projection">Somente captura de tela</string>
    <string name="engine_projection_subtitle">Diálogo do sistema, funciona sem acessibilidade</string>
    <string name="setting_auto_copy">Copiar após escanear</string>
    <string name="setting_auto_copy_subtitle">Coloca o valor bruto na área de transferência assim que um código é lido</string>
    <string name="setting_keep_session">Manter a sessão de captura ativa</string>
    <string name="setting_keep_session_subtitle">Uma permissão só, depois cada leitura é instantânea. O Android mantém uma notificação de captura enquanto a sessão estiver ativa.</string>
    <string name="status_session_on">Sessão ativa</string>
    <string name="action_stop">Parar</string>

