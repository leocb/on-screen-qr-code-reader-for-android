    <string name="section_accessibility">Accessibility fallback</string>
    <string name="status_enabled">Enabled</string>
    <string name="status_off">Off</string>
    <string name="action_manage">Manage</string>
    <string name="action_enable">Enable</string>
    <string name="accessibility_body">Optional. Some apps hide their content from screenshots. Turn on the Screen QR accessibility service to let this app take a single screenshot instead, without the system capture dialog. It reads nothing else and the screenshot never leaves the device.</string>
    <string name="accessibility_secure_note">Screens marked FLAG_SECURE (banking apps, streaming apps, some wallets) return a black frame to every method, accessibility included.</string>

    <string name="section_reading_method">Reading method</string>
    <string name="engine_auto">Automatic</string>
    <string name="engine_auto_subtitle">Accessibility when it is on, otherwise the system capture dialog</string>
    <string name="engine_accessibility">Accessibility only</string>
    <string name="engine_accessibility_subtitle">No dialog, but needs the service enabled</string>
    <string name="engine_projection">Screen capture only</string>
    <string name="engine_projection_subtitle">System dialog, works without accessibility</string>
    <string name="setting_auto_copy">Copy after scanning</string>
    <string name="setting_auto_copy_subtitle">Puts the raw value on the clipboard as soon as a code is read</string>
    <string name="setting_keep_session">Keep the capture session alive</string>
    <string name="setting_keep_session_subtitle">One permission prompt, then every scan is instant. Android keeps a capture notification while the session runs.</string>
    <string name="status_session_on">Session on</string>
